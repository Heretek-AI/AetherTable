# Multi-stage Rust build for vtt-server
FROM rust:1.85-slim-bookworm as builder

WORKDIR /usr/src/vtt
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p vtt-server

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/src/vtt/target/release/vtt-server /usr/local/bin/vtt-server
EXPOSE 8080
ENV RUST_LOG=info
CMD ["vtt-server"]
